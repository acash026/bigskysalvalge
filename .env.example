# Copy this file to .env.local (gitignored) and fill in real values for local
# development. In Vercel, set these under Project Settings -> Environment Variables.

# SMTP account used to SEND the quote-request and contact-form emails
# (technical inbox, not the address shown publicly on the site).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-gmail-app-password

# Where new leads/messages are delivered.
ADMIN_EMAIL=your-sending-account@gmail.com
# Public-facing contact address shown on the site and used as reply-to.
PUBLIC_CONTACT_EMAIL=contact@example.com

# Neon Postgres, used via Prisma (see prisma/schema.prisma) to store
# quote-request and contact-form submissions.
# DATABASE_URL: pooled connection (host ending in "-pooler") for the app at runtime.
# DIRECT_URL: unpooled connection, used only by `prisma migrate`.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"
